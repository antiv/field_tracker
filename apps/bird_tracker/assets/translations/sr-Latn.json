  "codes": {
    "0": "Negnezdarica (sumnja se da je jedinka na seobi ili da se samo zadržava tokom letnjeg perioda, ali se ne gnezdi)",
    "1": "Vrsta posmatrana u gnezdećoj sezoni u mogućem gnezdećem staništu",
    "2": "Teritorijalni (pevajući) mužjak/ci prisutan/ni tokom gnezdeće sezone",
    "3": "Par posmatran u staništu pogodnom za gnežđenje tokom gnezdeće sezone",
    "4": "Teritorijalno ponašanje (pesma, svadbeni let itd) zabeleženi tokom najmanje dva različita dana sa više od jedne sedmice razmaka na istom mestu",
    "5": "Udvaranje, šepurenje ili svadbeni let",
    "6": "Posećivanje moguće gnezdeće teritorije",
    "7": "Uznemireno ponašanje ili nervozno oglašavanje odraslih ptica",
    "8": "Gnezdeća pega na odraslim pticama pregledanim iz ruke",
    "9": "Izgradnja gnezda ili dubljenje gnezdeće duplje",
    "10": "Odvraćanje pažnje ili glumljenje povrede",
    "11": "Pronađeno korišćeno gnezdo/ljuske od jaja (zauzeto položeno tokom gnezdeće sezone)",
    "12": "Nedavno izleženi mladunci (čučavci) ili mladunci u paperju (potrkušci)",
    "13": "Roditelji koji posećuju gnezdo u okolnostima koje ukazuju na zauzetost gnezda ili roditelji posmatrani tokom inkubacije",
    "14": "Roditelji iznose izmet mladunaca iz gnezda ili nose hranu za mladunce",
    "15": "Pronađeno gnezdo sa jajima",
    "16": "Pronađeno gnezdo sa mladuncima (posmatrani ili slušani)"
  },
